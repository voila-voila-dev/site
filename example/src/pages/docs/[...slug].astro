---
import { getCollection, render } from "astro:content";
import DocsLayout from "@voila.dev/site/components/DocsLayout.astro";

export async function getStaticPaths() {
	return (await getCollection("docs")).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout
	title={entry.data.title}
	description={entry.data.description}
	siteName="example"
	headings={headings}
	nav={[{ title: "Start", items: [{ href: "/docs/getting-started", label: "Getting started" }] }]}
	top={{ name: "example", links: [{ href: "/docs/getting-started", label: "Docs" }] }}
	footer={{ note: "example · MIT · by", by: { href: "https://voila.dev", label: "VOILA DEVELOPMENT" } }}
>
	<Content />
</DocsLayout>
