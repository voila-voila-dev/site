---
// A section: a huge title on a rule, a small tag on the right, then the content.
interface Props {
	id?: string;
	title: string;
	tag?: string;
	class?: string;
}

const { id, title, tag, class: className } = Astro.props;
---

<section id={id} class={className}>
	<div class="head"><h2>{title}</h2>{tag && <span>{tag}</span>}</div>
	<slot />
</section>
